# EduOne SaaS Backend Environment Variables Template
# Ushbu fayldan nusxa olib .env fayli yarating va o'z haqiqiy maxfiy kalitlaringizni kiriting.
# Hech qachon .env faylini Git yoki jamoatga yubormang!

# Server sozlamalari
PORT=8080
APP_ENV=development # development, staging, production
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Xavfsizlik va JWT
JWT_SECRET=
JWT_EXPIRATION_HOURS=72
SUPERADMIN_INITIAL_PASSWORD=
TELEGRAM_WEBHOOK_SECRET=

# MySQL 8.0 Ma'lumotlar Bazasi
# DSN formati: foydalanuvchi:parol@tcp(host:port)/baza?parseTime=true&charset=utf8mb4&loc=Local
DATABASE_URL=root:password@tcp(127.0.0.1:3306)/eduone?parseTime=true&charset=utf8mb4&loc=Local
DB_MAX_CONNECTIONS=25
DB_MIN_CONNECTIONS=5

# Claude AI (Anthropic) Integratsiyasi
# https://console.anthropic.com orqali olingan API kalit
ANTHROPIC_API_KEY=sk-ant-api03-haqiqiy_kalitni_bu_yerga_qoying
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Telegram Bot Integratsiyasi
# @BotFather orqali olingan bot tokeni
TELEGRAM_BOT_TOKEN=1234567890:AAHaqiqiy_Tokenni_Bu_Yerga_Qoying
TELEGRAM_WEBHOOK_URL=https://api.eduone.uz/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=maxfiy_webhook_tekshiruv_tokeni
